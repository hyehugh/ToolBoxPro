# ToolboxPro Environment Configuration
# Copy this file to .env.local and fill in your values.

# Google Analytics (optional — leave empty to disable)
NEXT_PUBLIC_GA_ID=

# Google AdSense Publisher ID (e.g., ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Vercel KV (Redis) — required for visitor counter
# Provision a KV database in Vercel Dashboard → Storage → KV
# Then run: vercel env pull .env.local
# KV_URL=redis://...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# KV_REST_API_READ_ONLY_TOKEN=...
NEXT_PUBLIC_BASE_URL=https://trytoolboxpro.com

# Hugging Face API Token (free, get at https://huggingface.co/settings/tokens)
# Required for AI Translator. Free tier: ~30k input chars/month.
HF_API_TOKEN=
